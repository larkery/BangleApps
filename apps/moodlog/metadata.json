{
  "id": "moodlog",
  "name": "Mood Log",
  "shortName": "Mood Log",
  "version": "0.03",
  "description": "Periodic check-ins: tap icons for water, coffee, food, social contact, movement and mood (hold a mood for more detail), plus a morning sleep rating. Logs to CSV.",
  "icon": "app.png",
  "type": "app",
  "tags": "health,tool",
  "supports": [
    "BANGLEJS2"
  ],
  "readme": "README.md",
  "interface": "interface.html",
  "allow_emulator": true,
  "storage": [
    {
      "name": "moodlog.app.js",
      "url": "app.js"
    },
    {
      "name": "moodlog.boot.js",
      "url": "boot.js"
    },
    {
      "name": "moodlog",
      "url": "lib.js"
    },
    {
      "name": "moodlog.settings.js",
      "url": "settings.js"
    },
    {
      "name": "moodlog.img",
      "url": "app-icon.js",
      "evaluate": true
    }
  ],
  "data": [
    {
      "name": "moodlog.json"
    },
    {
      "name": "moodlog.state.json"
    },
    {
      "name": "moodlog.csv",
      "storageFile": true
    },
    {
      "name": "moodlog2.csv",
      "storageFile": true
    }
  ],
  "dependencies": {
    "scheduler": "type"
  }
}